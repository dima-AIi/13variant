<Window x:Class="FurnitureWorkshop.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — Мебельная мастерская" Width="670" Height="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" AutomationProperties.AutomationId="LoginWindow">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="#204537" Padding="27">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Мебельная&#10;мастерская" FontFamily="Georgia" FontSize="30" Foreground="#FFFDF7"/>
        <TextBlock Text="Учёт заказов, изготовления и установки мебели" Foreground="#E0E9DE"
                   TextWrapping="Wrap" Margin="0,17,0,0"/>
      </StackPanel>
    </Border>
    <StackPanel Grid.Column="1" Margin="37,30" VerticalAlignment="Center">
      <TextBlock Text="Вход в мастерскую" FontFamily="Georgia" FontSize="26" Margin="0,0,0,15"/>
      <Label Content="_Логин" Target="{Binding ElementName=Login}" Padding="0,6"/>
      <TextBox x:Name="Login" AutomationProperties.AutomationId="LoginInput"
               Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>
      <Label Content="_Пароль" Target="{Binding ElementName=Password}" Padding="0,12,0,6"/>
      <PasswordBox x:Name="Password" AutomationProperties.AutomationId="PasswordInput"/>
      <Button x:Name="SignInButton" Content="_Войти" AutomationProperties.AutomationId="SignInButton"
              Command="{Binding SignIn}" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0"/>
      <TextBlock AutomationProperties.AutomationId="LoginMessage" Foreground="#9D2C27" Text="{Binding Message}"
                 TextWrapping="Wrap" Margin="0,9,0,0" MinHeight="38"/>
    </StackPanel>
  </Grid>
</Window>
