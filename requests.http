# Выполнять сверху вниз на отдельной чистой базе с Workshop__SeedDemo=true.
# Пароли берутся из переменных среды WORKSHOP_DEMO_*_PASSWORD.
# Запросы создают и изменяют учебные записи. Настройки см. docs/api-tests.md.
@baseUrl = http://127.0.0.1:5130

###

# @name health
# expect: 200
GET {{baseUrl}}/health

###

# @name anonymous
# expect: 401
GET {{baseUrl}}/api/orders

###

# @name bad_login
# expect: 401
POST {{baseUrl}}/api/auth/login
Content-Type: application/json; charset=utf-8

{"login": "admin", "password": "invalid"}

###

# @name login_admin
# expect: 200
POST {{baseUrl}}/api/auth/login
Content-Type: application/json; charset=utf-8

{"login": "admin", "password": "{{$processEnv WORKSHOP_DEMO_ADMIN_PASSWORD}}"}

###

# @name login_manager
# expect: 200
POST {{baseUrl}}/api/auth/login
Content-Type: application/json; charset=utf-8

{"login": "manager", "password": "{{$processEnv WORKSHOP_DEMO_MANAGER_PASSWORD}}"}

###

# @name login_ivan
# expect: 200
POST {{baseUrl}}/api/auth/login
Content-Type: application/json; charset=utf-8

{"login": "ivan", "password": "{{$processEnv WORKSHOP_DEMO_IVAN_PASSWORD}}"}

###

# @name demo_check
# expect: 200
GET {{baseUrl}}/api/debug/requests
Authorization: Bearer {{login_admin.response.body.$.token}}

###

# @name demo_export_csv
# expect: 200
GET {{baseUrl}}/api/orders/export/csv
Authorization: Bearer {{login_admin.response.body.$.token}}

###

# @name demo_export_json
# expect: 200
GET {{baseUrl}}/api/orders/export/json
Authorization: Bearer {{login_admin.response.body.$.token}}

###

# @name demo_export_xml
# expect: 200
GET {{baseUrl}}/api/orders/export/xml
Authorization: Bearer {{login_admin.response.body.$.token}}

###

# @name prepare_admin
# expect: 201
POST {{baseUrl}}/api/orders
Authorization: Bearer {{login_manager.response.body.$.token}}
Content-Type: application/json; charset=utf-8

{"customerId": 1, "title": "Заказ для проверки прав", "address": "Учебный адрес", "assemblerId": 3}

